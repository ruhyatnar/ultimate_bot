# =============================================================================
# Ultimate Binance Market-Only Trading Bot — .env configuration
#
# Loaded by config.py via python-dotenv. Every key below is optional; the
# engine falls back to the same defaults shown here if a key is removed.
# Inference order: PRESET (intraday_rsi) -> .env override -> validation.
#
# NOTE on the active preset: STRATEGY_MODE is fixed to "rsi_dip" (daily
# EMA50 regime gate + 1h RSI dip trigger, fixed % bracket). The preset's
# proven defaults come from a 2026-09-14 backtest battery (NEARUSDT,
# +10.77%, 42 trades, WR 42.9%, PF 1.43, max DD 6.8%). Change with care.
#
# After editing:  pm2 reload ultimate-bot   (from ultimate-bot/)
# =============================================================================

# --- Boot --------------------------------------------------------------------
# Strategy preset. Only "intraday_rsi" exists.
PRESET=intraday_rsi

# true = simulated fills against real market data (safe, no keys needed).
# false = LIVE EXECUTION on Binance. Requires BINANCE_API_KEY plus either
# BINANCE_API_SECRET (HMAC) or BINANCE_PRIVATE_KEY_PATH (Ed25519).
PAPER_TRADE=true

# "spot" (proven default) or "futures" (USDⓈ-M via fapi).
MARKET=futures

# Testnet endpoints instead of production (works with paper or live).
USE_TESTNET=false

# --- Binance credentials (LIVE mode only) ------------------------------------
# API key. Required only when PAPER_TRADE=false.
BINANCE_API_KEY=your_binance_api_key_here
# HMAC secret. Ed25519 private key is preferred (see BINANCE_PRIVATE_KEY_PATH).
#BINANCE_API_SECRET=
# Ed25519 private key for signed requests (recommended over HMAC).
# Generate: openssl genpkey -algorithm Ed25519 -out keys/private_key.pem
BINANCE_PRIVATE_KEY_PATH=./keys/private_key.pem

# --- Storage paths -----------------------------------------------------------
DB_PATH=./data/trading.db
# CONTROL_FILE: web-monitor pause/close-all channel
CONTROL_FILE=./data/engine_control.json
# LOG_FILE: 10 MB x 5 rotating
LOG_FILE=./logs/trading.log

# --- Symbols & screener ------------------------------------------------------
# Comma-separated watchlist used when DYNAMIC_SYMBOLS=false.
STATIC_SYMBOLS=
# true = rank candidates via the 4-factor Z-score screener instead of the
# static list (MAX_SYMBOLS caps how many are actually traded).
DYNAMIC_SYMBOLS=true
MAX_SYMBOLS=5
TOP_CANDIDATES=25
MIN_VOLUME_USDT=1000000
MIN_PRICE_CHANGE_PERCENT=0.5
MIN_VOLATILITY_PERCENT=0.3
EXCLUDE_SYMBOLS=USDC,BUSD,UP,DOWN,FDUSD,TUSD,DAI
# Full rescan cadence (>= 60s). In-place price refresh runs every
# PRICE_REFRESH_INTERVAL (>= 10s) between rescans.
SYMBOL_REFRESH_INTERVAL=3600
PRICE_REFRESH_INTERVAL=10
# Screener weights (each 0..1; ADX carries 0.40 in the proven screener).
Z_SCORE_WEIGHT_VOLUME=0.20
Z_SCORE_WEIGHT_CHANGE=0.20
Z_SCORE_WEIGHT_VOLATILITY=0.20
Z_SCORE_WEIGHT_ADX=0.40
CORRELATION_THRESHOLD=0.70
CORRELATION_PENALTY=0.90
ADX_THRESHOLD=25
ADX_PERIOD=14
TREND_LOOKBACK=20
QUOTE_ASSET=USDT

# --- Strategy: intraday_rsi (rsi_dip mode) ------------------------------------
# Trigger timeframe bucket for RSI sampling (1m/3m/5m/15m/30m/1h).
RSI_TIMEFRAME=1h
RSI_PERIOD=14
RSI_OVERSOLD=40
# Additional entry quality gates (all optional; 0/false = gate off).
ENTRY_RSI_MIN=35
ENTRY_REQUIRE_RSI_RISE2=false
ENTRY_MAX_EXT_ATR=0
ENTRY_EXT_EMA=20
ENTRY_VOL_MULT=0
ENTRY_VOL_LOOKBACK=20
# Daily-EMA50 regime gate: never buy below the daily EMA50 or a falling slope.
REGIME_EMA=21
REGIME_SLOPE_DAYS=2

# --- Exits --------------------------------------------------------------------
# Fixed % bracket (fractions). Validation: 0 < SL < TP <= 1.
SL_PERCENT=0.012
TP_PERCENT=0.03
# Volatility-adaptive stop: >0 replaces the fixed % stop with
# SL_ATR_MULTIPLIER x ATR, clamped to SL_ATR_MAX_PERCENT of entry.
SL_ATR_MULTIPLIER=0
SL_ATR_MAX_PERCENT=0.024
# Trailing stop. ATR-trail mode when >0 (2.0 in the preset); otherwise the
# %-callback path applies: activate at TRAILING_STOP_ACTIVATE profit, trail by
# TRAILING_STOP_CALLBACK (callback must be < activate in that mode).
TRAILING_ATR_MULTIPLIER=2
TRAILING_STOP_ACTIVATE=0.01
TRAILING_STOP_CALLBACK=0.01
# Fee-aware breakeven lock (disabled in the proven preset).
BREAKEVEN_ENABLED=true
BREAKEVEN_TRIGGER=0.01
BREAKEVEN_OFFSET=0.0025
# +1R partial scale-out (disabled in the proven preset).
SCALE_OUT_ENABLED=false
SCALE_OUT_R_MULTIPLE=1.0
SCALE_OUT_FRACTION=0.5
# Force-close open positions at UTC day end (backtest parity).
CLOSE_AT_UTC_DAY_END=false
# Hard time stop (seconds, >= 60). Preset value ~= one day.
MAX_HOLD_TIME=84600
MIN_TP_PERCENT=0.03

# --- Risk management ----------------------------------------------------------
# Fixed-fractional risk per trade as a fraction of equity (max 0.1).
RISK_PER_TRADE=0.01
# Minimum R:R required to enter (TP distance / SL distance).
MIN_RISK_REWARD=1.5
# Notional ceilings as fractions of equity (keep at 1.0 on small accounts:
# caps below Binance's $5 minNotional silently skip every entry).
BALANCE_USAGE_PERCENT=1
MAX_SYMBOL_ALLOCATION_PERCENT=1
# Daily drawdown circuit breaker (fraction, e.g. 0.05 = 5%).
MAX_DAILY_DRAWDOWN=0.05
# Streak brakes and cooldowns (seconds).
MAX_LOSS_STREAK=3
MAX_WIN_STREAK=5
COOLDOWN_LOSS=3600
COOLDOWN_WIN=1800
# Per-symbol wait after any stop-out (revenge-trade brake).
LOSS_REENTRY_COOLDOWN=900
# Max entries per UTC day (0 = unlimited). 2/day is the proven frequency.
# MAX_TRADES_PER_DAY derives from the intraday_rsi preset (2/day, the validated value).
#MAX_TRADES_PER_DAY=0
# Order slippage guard (percent of price).
MAX_SLIPPAGE_PERCENT=0.5
# Auto-liquidate untracked exchange positions found during reconciliation.
AUTO_LIQUIDATE_ORPHANS=false
ORPHAN_ADOPT_WINDOW_HOURS=48

# --- USDⓈ-M futures (used only when MARKET=futures) ---------------------------
# One-way (BOTH) position mode — the engine's brackets assume a net position.
FUTURES_ONE_WAY_MODE=false
# ISOLATED caps loss at the position's margin; CROSSED risks the whole wallet.
FUTURES_MARGIN_TYPE=ISOLATED
# Initial leverage (1-125).
FUTURES_LEVERAGE=1
# Skip long entries when funding rate exceeds this fraction per interval
# (0 disables). 0.0005 ≈ 0.05%/8h.
FUNDING_RATE_MAX=0.0005

# --- Engine cadence & infrastructure ------------------------------------------
# Signal loop interval (seconds, >= 1).
SIGNAL_INTERVAL=10
# Wait before abandoning an unfilled market entry (seconds, >= 5).
ENTRY_TIMEOUT=15
# Health loop interval (seconds, >= 5).
HEALTH_CHECK_INTERVAL=60
# Local REST weight budget for the rate limiter (Binance allows 6000/min).
REST_WEIGHT_LIMIT=6000
# Max age of the WS user-data balance cache before REST fallback (seconds, >= 5).
WS_BALANCE_MAX_AGE=90
# Bulk-ticker REST fallback cadence when the !miniTicker socket is stale (seconds).
TICKERS_REST_FALLBACK_S=5

# --- Discord notifications ------------------------------------------------------
# Empty = notifications off. Paste a webhook URL to enable trade/daily reports.
DISCORD_WEBHOOK_URL=
# Minimum seconds between webhook sends.
DISCORD_COOLDOWN=30

# --- Logging --------------------------------------------------------------------
# DEBUG/INFO/WARNING/ERROR/CRITICAL. Keep INFO: DEBUG grew stdout 355 MB in 6h.
LOG_LEVEL=INFO
FUTURES_REST_WEIGHT_LIMIT=2400
SOAK_STALL_S=600
STRATEGY_MODE=rsi_dip
# RSI_TIMEFRAME_MS is intentionally NOT set: derived from RSI_TIMEFRAME in config.py.
# An explicit value that disagrees with RSI_TIMEFRAME silently re-times the RSI gate.
#RSI_TIMEFRAME_MS=3600000
TIMEFRAME=5m
MTF_TIMEFRAME=4h
ATR_PERIOD=14
